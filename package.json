{
  "name": "moon-courier-crisis",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Deterministic lunar logistics simulator with AI Mission Control",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run src/test/unit",
    "test:integration": "vitest run src/test/integration",
    "test:property": "vitest run src/test/property",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:syntax": "node scripts/check-syntax.mjs",
    "validate:structure": "node scripts/check-structure.mjs",
    "validate:sql": "tsx scripts/validate-sql.ts",
    "validate:domain": "tsx scripts/validate-domain.ts",
    "validate": "npm run validate:structure && npm run validate:sql && npm run validate:domain && npm run check:syntax && npm run check:static && npm run check",
    "check": "npm run typecheck && npm run lint && npm run test",
    "bootstrap": "npm run db:migrate && npm run db:seed",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:reset": "tsx scripts/db-reset.ts --yes",
    "db:inspect": "tsx scripts/db-inspect.ts",
    "game:reset": "tsx scripts/reset-demo-mission.ts",
    "simulate": "tsx scripts/run-simulation.ts",
    "verify:models": "tsx scripts/verify-models.ts",
    "evaluate:ai": "tsx scripts/evaluate-ai.ts",
    "report": "tsx scripts/generate-evidence-report.ts",
    "export:data": "tsx scripts/export-demo-data.ts",
    "screenshots": "tsx scripts/capture-screenshots.ts",
    "smoke": "node scripts/smoke.mjs",
    "clean": "node scripts/clean.mjs",
    "check:docs": "node scripts/check-doc-links.mjs",
    "check:assets": "node scripts/check-static-assets.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:static": "npm run check:docs && npm run check:assets && npm run check:secrets"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "next": "16.3.1",
    "pino": "^9.9.0",
    "react": "19.2.8",
    "react-dom": "19.2.0",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^9.34.0",
    "eslint-config-next": "16.3.1",
    "fast-check": "^4.3.0",
    "pino-pretty": "^13.1.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^4.0.0"
  }
}
