# Application
NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info
DATABASE_PATH=./data/moon-courier.db
DB_AUTO_MIGRATE=true
DEMO_AUTO_SEED=true

# AI via OpenRouter. The game itself works without this key.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_ENABLED=true
AI_PRIMARY_MODEL=deepseek/deepseek-v4-flash-0731
AI_FALLBACK_MODEL=openai/gpt-5.6-luna
AI_REQUEST_TIMEOUT_MS=25000
AI_MAX_TOOL_TURNS=4
AI_MAX_OUTPUT_TOKENS=1400
AI_DAILY_BUDGET_USD=3
AI_REASONING_ENABLED=false
AI_PROVIDER_REQUIRE_PARAMETERS=true
AI_DATA_COLLECTION=deny

# Price estimates are configurable because provider pricing changes.
AI_PRIMARY_INPUT_USD_PER_M=0.0798
AI_PRIMARY_OUTPUT_USD_PER_M=0.1596
AI_FALLBACK_INPUT_USD_PER_M=0.10
AI_FALLBACK_OUTPUT_USD_PER_M=0.60

# Public attribution headers accepted by OpenRouter.
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Moon Courier Crisis

# Simple demo protection
API_RATE_LIMIT_PER_MINUTE=30
ADMIN_TOKEN=change-me-for-public-deployment
